{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timetracker",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Własna domena: deploy sam tworzy rekord DNS i certyfikat (strefa mioduch.com musi być aktywna)
  "routes": [{ "pattern": "tracker.mioduch.com", "custom_domain": true }],
  "vars": {
    "APP_TZ": "Europe/Warsaw",
    // Odbiorca tygodniowego raportu
    "REPORT_TO": "patryk.mioduch@gmail.com",
    // Nadawca: adres w domenie dodanej do Cloudflare Email Sending (wrangler email sending enable <domena>)
    "REPORT_FROM": "timetracker@mioduch.com"
  },
  // Poniedziałek 06:00 UTC = 07:00 CET / 08:00 CEST
  "triggers": { "crons": ["0 6 * * 1"] },
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timetracker",
      "database_id": "c960ef8d-ddf0-4b37-84f1-249589d392e7",
      "migrations_dir": "./migrations"
    }
  ]
}
